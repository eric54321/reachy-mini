# Copy to .env (gitignored) and fill in per-machine values. Never commit .env.
# Only needed if a script/robot config requires overriding the default mDNS
# discovery (connection_mode="auto", hostname "reachy-mini").

# REACHY_MINI_ROBOT_NAME=reachy-mini

# --- apps/voice_gesture: physical robot vs. simulator toggle ---
# "physical" (default) connects to the real robot at REACHY_MINI_HOST.
# "sim" connects to a local `reachy-mini-daemon --sim --headless --fastapi-port
# <REACHY_MINI_SIM_PORT>` you start yourself (see SETUP.md's "Running the
# daemon" section). mDNS doesn't resolve reachy-mini.local on this network, so
# REACHY_MINI_HOST is a plain IP, not the hostname.
# REACHY_MINI_MODE=physical
# REACHY_MINI_HOST=192.168.50.216
# REACHY_MINI_SIM_HOST=localhost
# REACHY_MINI_SIM_PORT=8090
